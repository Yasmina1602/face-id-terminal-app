# ========================================================
# Telegram Bot va Hikvision Tinglovchisi Konfiguratsiyasi
# Ushbu fayldan nusxa olib, telegram_bot/.env yarating:
# Windows: copy telegram_bot\env.example telegram_bot\.env
# Linux:   cp telegram_bot/env.example telegram_bot/.env
# ========================================================

# Telegram bot tokeni (@BotFather orqali olingan)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Xabarlar yuboriladigan Telegram guruh yoki kanal ID lari (ixtiyoriy, vergul bilan bir nechta: -100123456789,-100987654321)
TELEGRAM_CHAT_ID=

# Asosiy adminlarning Telegram raqamli ID lari (o'chirib bo'lmaydigan superadminlar, vergul bilan: 12345678,87654321)
ADMIN_IDS=

# Hikvision yuz tanish terminali tarmoq sozlamalari
HIKVISION_IP=192.168.11.151
HIKVISION_USER=admin
HIKVISION_PASSWORD=parol_kiriting

# Webhook tinglash porti (Hikvision terminali so'rov yuboradigan port)
PORT=8095

# PostgreSQL ma'lumotlar bazasi ulanish sozlamalari
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=face_id_terminal
DB_USER=root
DB_PASS=1234

# Ish vaqti parametrlari
DEFAULT_START=08:00
GRACE_MINUTES=0
RETENTION_DAYS=180
WEEKEND_DAYS=6
TZ_NAME=Asia/Tashkent
LOG_LEVEL=INFO

# Hikvision terminaldan kelayotgan JSON hodisalarni to'liq logda ko'rish (1 - yoqish, 0 - o'chirish)
DEBUG_EVENTS=0
