# ========================================================
# Web API Backend Konfiguratsiyasi (FastAPI)
# Ushbu fayldan nusxa olib, web/.env.web yarating:
# Windows: copy web\.env.web.example web\.env.web
# Linux:   cp web/.env.web.example web/.env.web
# ========================================================

# Muhit holati: development | production
APP_ENV=development

# JWT sessiya va xavfsizlik kaliti (Productionda tasodifiy murakkab kalit qo'ying)
SECRET_KEY=super-secret-key-change-in-production-davomat-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# PostgreSQL ma'lumotlar bazasi (telegram_bot/.env bilan bir xil bo'lishi kerak)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=face_id_terminal
DB_USER=root
DB_PASS=1234
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Telegram bot tokeni (Telegram login widget tekshiruvi uchun, bot tokeni bilan bir xil)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Vaqt mintaqasi
TZ_NAME=Asia/Tashkent

# Web API server porti
WEB_PORT=8090
WEB_HOST=0.0.0.0
